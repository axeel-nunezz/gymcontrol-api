PORT=3000
NODE_ENV=production

# Cliente OAuth Web del backend desplegado en Render.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REDIRECT_URI=https://tu-servicio.onrender.com/oauth/google/callback

# Se completa después del bootstrap OAuth descrito en README.md.
GOOGLE_REFRESH_TOKEN=

# Genera tres valores independientes y aleatorios de al menos 32 caracteres.
GYMCONTROL_API_KEY=reemplazar-por-un-secreto-aleatorio-de-48-bytes
OAUTH_ADMIN_KEY=reemplazar-por-otro-secreto-aleatorio-de-48-bytes
OAUTH_STATE_SECRET=reemplazar-por-un-tercer-secreto-aleatorio-de-48-bytes

# Opcionales. Déjalo vacío en la primera instalación: con drive.file el backend
# debe crear su propia carpeta, salvo que este mismo cliente OAuth ya tenga acceso.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=GymControl - Respaldos
MAX_BACKUP_MB=64
BACKUP_RATE_LIMIT=30
EMAIL_RATE_LIMIT=10
OAUTH_RATE_LIMIT=20
